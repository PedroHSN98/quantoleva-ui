{
  "name": "speedtest-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "worker": "tsx --env-file=.env.local worker/index.ts",
    "worker:prod": "tsx worker/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
