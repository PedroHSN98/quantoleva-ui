# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgres://speedtest:speedtest_dev_only@127.0.0.1:5433/speedtest
# Secret used to hash client IPs for rate limiting (any long random string)
IP_HASH_SECRET=
# Slug of the location this worker runs in (must exist in the locations table)
WORKER_LOCATION=sa-east
# Tests measured at the same time by one worker (each runs its own browser, about 200-300 MB)
WORKER_CONCURRENCY=3
# Tests a client may start per 10 minutes (default 15)
RATE_LIMIT_MAX=
